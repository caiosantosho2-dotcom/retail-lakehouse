{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "acionamento_crm.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["grao", "linhas"],
  "properties": {
    "grao": {"type": "string", "minLength": 1},
    "linhas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capacidade", "metodo", "pausas_esperadas", "faturamento_26s_em_jogo", "mix_segmentos", "precisao_historica", "pausas_capturadas_historica"],
        "properties": {
          "capacidade": {"type": "integer", "minimum": 1},
          "metodo": {"enum": ["modelo", "regra_simples"]},
          "pausas_esperadas": {"type": ["number", "null"], "minimum": 0, "description": "esta semana, só no método modelo"},
          "faturamento_26s_em_jogo": {"type": ["number", "null"], "minimum": 0, "description": "esta semana, só no método modelo; não é o dinheiro em risco da G4"},
          "mix_segmentos": {
            "type": ["object", "null"],
            "description": "esta semana, só no método modelo: quantos dos N são de cada segmento",
            "required": ["Fiéis", "Regulares", "Esporádicos", "Em pausa"],
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "precisao_historica": {"type": "number", "minimum": 0, "maximum": 1},
          "pausas_capturadas_historica": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
